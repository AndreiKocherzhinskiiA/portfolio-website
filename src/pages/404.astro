---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base
  title={`404 Signal Lost | ${site.name}`}
  description="Requested frequency is unmapped."
  noindex={true}
>
  <section class="error-page wrap">
    <div class="error-page__grid">
      <div class="error-page__copy">
        <p class="kicker">Error 404 &middot; Frequency Unbound</p>
        <h1 class="error-page__code" data-split="lines" data-intro>404</h1>
        <p class="about-prose" style="max-width: 44ch;">
          No active project or case study responds at this route. Return to the primary
          index to inspect active frequencies and repositories.
        </p>
        <a class="btn" href="/" data-fill data-magnetic="0.18">
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Return to Index</span>
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="error-page__stage">
        <div
          class="error-page__gl"
          data-gl="procedural"
          data-colors="#0d0e12,#141b2d,#0e46d4"
          data-seed="9.9"
          data-gl-instant=""
          aria-hidden="true"
        >
          <div class="gl-fallback"></div>
        </div>
        <div class="error-page__telemetry">
          <span>SIGNAL / 000.0 HZ</span>
          <span>ROUTE UNBOUND</span>
        </div>
      </div>
    </div>
  </section>
</Base>
