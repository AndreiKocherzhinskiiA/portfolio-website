---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, projects, capabilities, archiveRepos } from '../data/site';

const previewAssets = await Promise.all(
  projects.map((p) =>
    getImage({ src: p.cover.image, width: 720, format: 'webp', quality: 80 })
  )
);
---
<Base
  title={`${site.name} | Software Engineer & Full-Stack Developer`}
  description={site.description}
>
  <section class="hero wrap">
    <div class="hero__telemetry" data-reveal="fade" data-intro>
      <div class="signal-pill">
        <span class="signal-pill__pulse" aria-hidden="true"></span>
        <span>
          SIGNAL:{' '}
          <strong data-signal-readout>14.0 HZ · BARCELONA</strong>
        </span>
      </div>
      <p class="kicker">Epitech Computer Science · Co-Founder, A&amp;A Devs</p>
    </div>

    <div class="hero__center">
      <div class="hero__wordmark">
        <h1 class="hero__title" data-reveal="up" data-intro>
          <span class="hero__first">{site.firstName}</span>
          <span class="hero__last" data-hero-wdth>{site.lastName}</span>
        </h1>
      </div>

      <div class="hero__channels" aria-label="Quick project signal frequencies">
        {projects.map((p) => (
          <a
            class="channel-chip"
            href={`/work/${p.slug}/`}
            data-freq-index={p.freqIndex}
            data-freq-label={`${p.index} · ${p.signalHz} · ${p.title}`}
          >
            {p.index} · {p.signalHz}
          </a>
        ))}
      </div>
    </div>

    <div class="hero__bottom">
      <p class="hero__statement" data-split="lines" data-intro>
        Software engineer building local LLM developer tools, pure Swift 6 iOS
        clients, cryptographic NFC hospitality SaaS, and C++17 network systems.
      </p>

      <div class="hero__actions" data-reveal="fade" data-intro>
        <a class="btn" href="#work" data-fill data-magnetic="0.18">
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Selected Systems</span>
          <span class="btn__arrow" aria-hidden="true">&darr;</span>
        </a>
        <a class="btn-ghost" href="/about/">
          <span>Engineering Profile</span>
          <span class="btn-ghost__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section id="work" class="work-index wrap" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading" class="section-head__title">Selected Systems</h2>
      <p class="kicker">01 to 05 · Signal channels</p>
    </div>

    <ul class="index-list" data-index>
      {projects.map((p, idx) => (
        <li>
          <a
            class="index-row"
            href={`/work/${p.slug}/`}
            data-preview={previewAssets[idx].src}
            data-preview-tag={`${p.index} · ${p.signalHz}`}
            data-freq-index={p.freqIndex}
            data-freq-label={`${p.index} · ${p.signalHz} · ${p.title}`}
          >
            <span class="mono kicker">{p.index}</span>
            <span class="index-row__title">
              {p.title}
              <span class="index-row__sub">{p.subtitle}</span>
            </span>
            <span class="index-row__discipline">{p.discipline}</span>
            <span class="index-row__freq">{p.signalHz}</span>
            <span class="index-row__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="index-preview" aria-hidden="true">
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
        width="720"
        height="450"
        decoding="async"
      />
      <span class="index-preview__tag" data-preview-tag>
        {projects[0].index} · {projects[0].signalHz}
      </span>
    </div>
  </section>

  <section class="plates wrap" aria-labelledby="plates-heading">
    <h2 id="plates-heading" class="sr-only">Flagship Engineering Case Plates</h2>
    {projects.map((p, idx) => (
      <article class={`plate-pair ${idx % 2 === 1 ? 'plate-pair--reverse' : ''}`}>
        <a
          class="plate-pair__media"
          href={`/work/${p.slug}/`}
          aria-label={`Open ${p.title} case study`}
          data-gl=""
          data-cursor="Open"
        >
          <Image
            src={p.cover.image}
            widths={[540, 880]}
            sizes="(max-width: 900px) 92vw, 56vw"
            format="webp"
            quality={82}
            alt={p.cover.alt}
            loading="lazy"
          />
        </a>

        <div class="plate-pair__copy" data-reveal="up">
          <p class="kicker">{p.index} / {p.period}</p>
          <h3 class="plate-pair__title">{p.title}</h3>
          <p class="plate-pair__summary">{p.summary}</p>

          <div class="plate-pair__metrics">
            {p.metrics.slice(0, 3).map((m) => (
              <div>
                <span class="metric-val">{m.value}</span>
                <span class="metric-lbl">{m.label}</span>
              </div>
            ))}
          </div>

          <a class="btn-ghost" href={`/work/${p.slug}/`}>
            <span>Read Case Study</span>
            <span class="btn-ghost__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="layers-section wrap" aria-labelledby="layers-heading">
    <div class="layers-layout">
      <div class="layers-sticky">
        <p class="kicker">Architecture Spectrum</p>
        <h2 id="layers-heading" class="layers-sticky__title" data-split="lines">
          Four layers, one standard.
        </h2>
        <p class="layers-sticky__body">
          Whether shipping native Swift 6 on a physical iPhone, validating AES-CMAC
          hospitality payloads, or orchestrating C++17 poll loops, each system is
          verified with deterministic tests and explicit boundaries.
        </p>
      </div>

      <div class="layers-list">
        {capabilities.map((c) => (
          <article class="layer-item" data-reveal="up">
            <p class="kicker">{c.code}</p>
            <h3 class="layer-item__title">{c.title}</h3>
            <p class="layer-item__detail">{c.detail}</p>
            <div class="layer-item__specs">
              {c.specs.map((s) => (
                <span class="spec-chip">{s}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="archive" class="archive-section wrap" aria-labelledby="archive-heading">
    <div class="section-head">
      <h2 id="archive-heading" class="section-head__title">GitHub Systems Archive</h2>
      <a
        class="inline-link mono"
        style="font-size: var(--t-xs); min-height: 36px; display: inline-flex; align-items: center;"
        href="https://github.com/AndreiKocherzhinskiiA"
        target="_blank"
        rel="noopener noreferrer"
      >
        All 11 repositories &nearr;
      </a>
    </div>

    <div class="archive-grid">
      {archiveRepos.map((repo, idx) => (
        <a
          class="archive-card"
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal="up"
          data-delay={String((idx % 4) * 0.05)}
          data-cursor="Repo"
        >
          <div class="archive-card__head">
            <span class="kicker">{repo.category}</span>
            <span class="mono" style="font-size: var(--t-xs); color: var(--c-muted);">
              {repo.language}
            </span>
          </div>
          <h3 class="archive-card__title">{repo.name}</h3>
          <p class="archive-card__summary">{repo.summary}</p>
          <div class="archive-card__foot">
            <span>GitHub Source</span>
            <span class="archive-card__arrow" aria-hidden="true">&nearr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
